  "params": {},
  "propConfig": {
    "custom.avgData": {
      "binding": {
        "config": {
          "parameters": {
            "database": "{view.custom.database}",
            "line_name": "{session.custom.exchange.launchpad.oee.selectedLine}",
            "start_time": "{session.custom.exchange.launchpad.oee.display.startTime}",
            "stop_time": "{session.custom.exchange.launchpad.oee.display.stopTime}",
            "tag_folder": "{view.custom.tagFolder}"
          },
          "queryPath": "Exchange/Launchpad/Oee/HourlyStatsAverage",
          "returnFormat": "json"
        },
        "type": "query"
      },
      "persistent": true
    },
    "custom.database": {
      "binding": {
        "config": {
          "path": "/root.meta.name"
        },
        "transforms": [
          {
            "code": "\treturn exchange.launchpad.oee.DATABASE_NAME\n\t",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.oeeData": {
      "binding": {
        "config": {
          "struct": {
            "data": "{view.custom.rawData}",
            "type": "{view.custom.timeRange}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tpyData \u003d system.dataset.toPyDataSet(value.data)\n\theaders \u003d [\"Timestamp\", \"Availability\", \"Performance\", \"Quality\", \"OEE\"]\n\tdata \u003d []\n\t\n\trowRange \u003d pyData.getRowCount() - 1\n\n\tfor r in range(rowRange):\n\t\tdata.append([pyData.getValueAt(r, \"time_stamp\"), pyData.getValueAt(r, \"oee_a\"), pyData.getValueAt(r, \"oee_p\"), pyData.getValueAt(r, \"oee_q\"), pyData.getValueAt(r, \"oee\")])\n\treturn system.dataset.toDataSet(headers, data)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.productionData": {
      "binding": {
        "config": {
          "path": "view.custom.rawData"
        },
        "transforms": [
          {
            "code": "\tpyData \u003d system.dataset.toPyDataSet(value)\n\theaders \u003d [\"Timestamp\", \"Rejects\", \"Target\", \"Production\"]\n\tdata \u003d []\n\tfor r in range(pyData.getRowCount()-1):\n\t\tpyData.getValueAt(r, \"time_stamp\")\n\t\tpyData.getValueAt(r, \"reject_count\")\n\t\tpyData.getValueAt(r, \"target_rate\")\n\t\tpyData.getValueAt(r, \"production_count\")\n\n\t\t\n\t\tdata.append([pyData.getValueAt(r, \"time_stamp\"), pyData.getValueAt(r, \"reject_count\"), pyData.getValueAt(r, \"target_rate\")*60, pyData.getValueAt(r, \"production_count\") ])\n\treturn system.dataset.toDataSet(headers, data)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.rawData": {
      "binding": {
        "config": {
          "parameters": {
            "database": "{view.custom.database}",
            "line_name": "{session.custom.exchange.launchpad.oee.selectedLine}",
            "start_time": "{session.custom.exchange.launchpad.oee.display.startTime}",
            "stop_time": "{session.custom.exchange.launchpad.oee.display.stopTime}",
            "tag_folder": "{view.custom.tagFolder}"
          },
          "queryPath": "Exchange/Launchpad/Oee/HourlyStats",
          "returnFormat": "dataset"
        },
        "type": "query"
      },
      "persistent": true
    },
    "custom.stats": {
      "binding": {
        "config": {
          "struct": {
            "data": "{view.custom.rawData}",
            "interval": "{session.custom.exchange.launchpad.oee.display.interval}",
            "mode": "{session.custom.exchange.launchpad.oee.display.mode}",
            "tag": "{view.custom.tag}",
            "type": "{view.custom.timeRange}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\t\t\n\tif value.mode \u003d\u003d \"Realtime\":\n\t\t\n\t\ta \u003d value.tag[\"%sOee\"%(value.interval)][\"A\"]\n\t\tp \u003d value.tag[\"%sOee\"%(value.interval)][\"P\"]\n\t\tq \u003d value.tag[\"%sOee\"%(value.interval)][\"Q\"]\n\t\td \u003d value.tag[\"%sOee\"%(value.interval)][\"D\"]\n\t\toee \u003d value.tag[\"%sOee\"%(value.interval)][\"O\"]\n\t\tdata \u003d {\"oee\":oee, \"availability\":a, \"performance\":p, \"quality\":q, \"downtime\":d, \"currentShift\": self.custom.tag.Schedule.CurrentShift}\n\telse:\n\t\tif self.custom.avgData \u003d\u003d None:\n\t\t\tdata \u003d {}\n\t\telif len(self.custom.avgData) \u003e\u003d 1:\n\t\t\ta \u003d  self.custom.avgData[0].oee_a\n\t\t\toee \u003d self.custom.avgData[0].oee\n\t\t\tp \u003d self.custom.avgData[0].oee_p\n\t\t\tq \u003d self.custom.avgData[0].oee_q\n\t\t\td \u003d self.custom.avgData[0].downtime\n\t\t\tdata \u003d {\"oee\":oee, \"availability\":a, \"performance\":p, \"quality\":q, \"downtime\":d, \"currentShift\":0}\n\t\telse:\n\t\t\tdata \u003d {}\n\t\t\n\t\n\n\t\n\treturn data",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.tag": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "Line": "{session.custom.exchange.launchpad.oee.selectedLine}",
            "LineFolder": "{session.custom.exchange.launchpad.oee.lineTagFolder}"
          },
          "tagPath": "{LineFolder}/{Line}"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.tagFolder": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "transforms": [
          {
            "code": "\treturn exchange.launchpad.oee.BASE_TAG_FOLDER",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.topProductionData": {
      "binding": {
        "config": {
          "parameters": {
            "database": "{view.custom.database}",
            "endTime": "{session.custom.exchange.launchpad.oee.display.stopTime}",
            "lineName": "{session.custom.exchange.launchpad.oee.selectedLine}",
            "startTime": "{session.custom.exchange.launchpad.oee.display.startTime}"
          },
          "queryPath": "Exchange/Launchpad/Oee/TopProduction",
          "returnFormat": "dataset"
        },
        "type": "query"
      },
      "persistent": true
    }
  },
