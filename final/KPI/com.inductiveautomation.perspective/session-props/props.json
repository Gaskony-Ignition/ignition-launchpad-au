{
  "custom": {
    "exchange": {
      "historyProvider": "launchpad",
      "launchpad": {
        "dashboard": {
          "mobileBreakpoint": 1100,
          "objects": {
            "edit": {}
          },
          "options": {
            "overrideUsername": "admin",
            "url": ""
          }
        }
      }
    }
  },
  "propConfig": {
    "custom.exchange.launchpad.dashboard.dashboards": {
      "binding": {
        "config": {
          "path": "this.custom.exchange.launchpad.dashboard.options.username"
        },
        "transforms": [
          {
            "code": "\tvalue = system.db.runNamedQuery(path=\"Exchange/Launchpad/Dashboard/Get\", parameters={\"username\":value})\n\tvalue = system.dataset.toPyDataSet(value)\n\treturn exchange.launchpad.dashboard.getDashboards(value)",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.exchange.launchpad.dashboard.dbValid": {
      "binding": {
        "config": {
          "queryPath": "Exchange/Launchpad/Dashboard/DB Check"
        },
        "transforms": [
          {
            "code": "\treturn False if value == None else value == 1",
            "type": "script"
          }
        ],
        "type": "query"
      }
    },
    "custom.exchange.launchpad.dashboard.objects.current": {
      "binding": {
        "config": {
          "struct": {
            "dashboards": "{this.custom.exchange.launchpad.dashboard.dashboards}",
            "url": "{this.custom.exchange.launchpad.dashboard.options.url}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\turl = value[\"url\"]\n\tdashboards = value[\"dashboards\"]\n\treturn exchange.launchpad.dashboard.getCurrentDashboard(dashboards, url)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.exchange.launchpad.dashboard.objects.currentLastModified": {
      "binding": {
        "config": {
          "parameters": {
            "id": "{this.custom.exchange.launchpad.dashboard.objects.current.id}"
          },
          "polling": {
            "enabled": true,
            "rate": "30"
          },
          "queryPath": "Exchange/Launchpad/Dashboard/Last Modified"
        },
        "type": "query"
      }
    },
    "custom.exchange.launchpad.dashboard.options.isDesigner": {
      "binding": {
        "config": {
          "expression": "{this.props.device.type} = 'designer'"
        },
        "type": "expr"
      }
    },
    "custom.exchange.launchpad.dashboard.options.username": {
      "binding": {
        "config": {
          "expression": "if({this.custom.exchange.launchpad.dashboard.options.isDesigner}, \r\n{this.custom.exchange.launchpad.dashboard.options.overrideUsername},\r\n{this.props.auth.user.userName})"
        },
        "transforms": [
          {
            "code": "\treturn value if value else 'Anonymous'",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "props.auth": {
      "access": "PRIVATE",
      "persistent": false
    },
    "props.device.accelerometer": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.identifier": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.timezone": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.type": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.userAgent": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.gateway": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.geolocation.data": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.geolocation.permissionGranted": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.host": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.id": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.lastActivity": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.offline.capable": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.offline.enabled": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.offline.lastSynced": {
      "access": "SYSTEM",
      "persistent": false
    }
  },
  "props": {
    "address": "127.0.0.1",
    "appBar": {
      "togglePosition": "hidden"
    },
    "device": {},
    "geolocation": {},
    "locale": "en-AU",
    "offline": {},
    "theme": "dark",
    "timeZoneId": "UTC"
  }
}