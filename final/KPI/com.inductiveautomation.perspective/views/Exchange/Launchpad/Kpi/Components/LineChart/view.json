{
  "custom": {
    "aggMode": "Maximum",
    "history": [],
    "tags": []
  },
  "params": {
    "aggMode": "Maximum",
    "path1": "",
    "path2": "",
    "title": "Title"
  },
  "propConfig": {
    "custom.aggMode": {
      "binding": {
        "config": {
          "path": "view.params.aggMode"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.history": {
      "binding": {
        "config": {
          "aggregate": "MinMax",
          "avoidScanClassValidation": true,
          "dateRange": {
            "mostRecent": "24",
            "mostRecentUnits": "HOUR"
          },
          "enableValueCache": true,
          "ignoreBadQuality": false,
          "polling": {
            "enabled": true,
            "rate": "30"
          },
          "preventInterpolation": false,
          "returnFormat": "Wide",
          "returnSize": {
            "delay": "1",
            "delayUnits": "HOUR",
            "type": "INTERVAL"
          },
          "tags": "{view.custom.tags}",
          "valueFormat": "DOCUMENT"
        },
        "transforms": [
          {
            "code": "\t# Timeseries chart expects \u0027time\u0027 rather than \u0027t_stamp\u0027.\n\tfor row in value:\n\t\trow[\u0027time\u0027] \u003d row.pop(\u0027t_stamp\u0027)\t\t\n\t\t\n\treturn value",
            "type": "script"
          }
        ],
        "type": "tag-history"
      },
      "persistent": true
    },
    "custom.tags": {
      "binding": {
        "config": {
          "struct": {
            "aggMode": "{view.custom.aggMode}",
            "tagPath1": "{view.params.path1}",
            "tagPath2": "{view.params.path2}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tdef getTagName(tagPath):\n\t\t# Get name from Documentation of tag.\n\t\ttagName \u003d system.tag.read(\u0027{tagPath}.Documentation\u0027.format(tagPath \u003d tagPath)).value\n\t\t\n\t\tif not tagName:\n\t\t\t# No name found in Documentation. Use tag name instead.\n\t\t\ttagName \u003d system.tag.read(\u0027{tagPath}.name\u0027.format(tagPath \u003d tagPath)).value\n\t\t\t\n\t\t# Get the eng units of tag.\n\t\tengUnit \u003d system.tag.read(\u0027{tagPath}.engUnit\u0027.format(tagPath \u003d tagPath)).value\n\t\t\n\t\tif engUnit:\n\t\t\treturn \u0027{tagName} ({engUnit})\u0027.format(tagName \u003d tagName, engUnit \u003d engUnit)\n\t\telse:\n\t\t\treturn tagName\n\t\t\t\n\tdef getRealtimePath(historicalPath):\n\t\ttagDelim \u003d \":/tag:\"\n\t\t\n\t\tparts \u003d historicalPath.rsplit(tagDelim, 1)\n\t\t\n\t\textractedPath \u003d \"\"\n\t\t\n\t\tif len(parts) \u003e 1:\n\t\t\textractedPath \u003d parts[1]\n\t\telse:\n\t\t\textractedPath \u003d historicalPath\n\t\n\t\t# Default fallback.\n\t\tprovName \u003d \"default\"\n\t\t\n\t\tif tagDelim in historicalPath:\n\t\t\tsegBeforeTagDelim \u003d historicalPath.split(tagDelim, 1)[0]\n\t\t\tlastColonIndex \u003d segBeforeTagDelim.rfind(\":\")\n\t\t\t\n\t\t\tif lastColonIndex !\u003d -1:\n\t\t\t\tprovName \u003d segBeforeTagDelim[lastColonIndex + 1:]\n\t\t\telse:\n\t\t\t\tprovName \u003d segBeforeTagDelim.rsplit(\":\", 1)[-1]\n\t\t\t\t\n\t\t\t\tif provName.startswith(\"histprov\"):\n\t\t\t\t\tprovName \u003d provName.split(\":\", 1)[-1]\n\t\t\t\tif not provName:\n\t\t\t\t\tprovName \u003d \"default\"\n\t\t\t\t\t\n\t\treturn \"[{}]{}\".format(provName, extractedPath)\n\t\t\n\ttags \u003d []\n\t\n\ttagPath1 \u003d value.get(\u0027tagPath1\u0027)\n\ttagPath2 \u003d value.get(\u0027tagPath2\u0027)\n\t\n\trealtimePath1 \u003d getRealtimePath(tagPath1) if \":/tag:\" in tagPath1 else tagPath1\n\trealtimePath2 \u003d getRealtimePath(tagPath2) if \":/tag:\" in tagPath2 else tagPath2\n\t\n\tif tagPath1:\n\t\ttags.append({\"aggregate\": value.get(\u0027aggMode\u0027), \"alias\": getTagName(realtimePath1), \"path\": realtimePath1})\n\t\t\n\tif tagPath2:\n\t\ttags.append({\"aggregate\": value.get(\u0027aggMode\u0027), \"alias\": getTagName(realtimePath2), \"path\": realtimePath2})\n\t\t\n\treturn tags",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.aggMode": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.path1": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.path2": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 343,
      "width": 462
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Title"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.title"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "exchange/launchpad/kpi/text/header"
              }
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "LabelInterval"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "text": "Aggregation:"
                },
                "type": "ia.display.label"
              },
              {
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\t# Stop propagation to prevent opening the history popup when interacting with the dropdown.\n\tpass"
                      },
                      "scope": "G",
                      "stopPropagation": true,
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "Dropdown"
                },
                "position": {
                  "basis": "155px",
                  "shrink": 0
                },
                "propConfig": {
                  "props.value": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "view.custom.aggMode"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "options": [
                    {
                      "label": "Average",
                      "value": "Average"
                    },
                    {
                      "label": "MinMax",
                      "value": "MinMax"
                    },
                    {
                      "label": "LastValue",
                      "value": "LastValue"
                    },
                    {
                      "label": "SimpleAverage",
                      "value": "SimpleAverage"
                    },
                    {
                      "label": "Sum",
                      "value": "Sum"
                    },
                    {
                      "label": "Minimum",
                      "value": "Minimum"
                    },
                    {
                      "label": "Maximum",
                      "value": "Maximum"
                    },
                    {
                      "label": "DurationOn",
                      "value": "DurationOn"
                    },
                    {
                      "label": "DurationOff",
                      "value": "DurationOff"
                    },
                    {
                      "label": "CountOn",
                      "value": "CountOn"
                    },
                    {
                      "label": "CountOff",
                      "value": "CountOff"
                    },
                    {
                      "label": "Count",
                      "value": "Count"
                    },
                    {
                      "label": "Range",
                      "value": "Range"
                    },
                    {
                      "label": "Variance",
                      "value": "Variance"
                    },
                    {
                      "label": "StdDev",
                      "value": "StdDev"
                    },
                    {
                      "label": "PctGood",
                      "value": "PctGood"
                    },
                    {
                      "label": "PctBad",
                      "value": "PctBad"
                    }
                  ],
                  "style": {
                    "classes": "exchange/launchpad/kpi/components/bar-chart/entry",
                    "width": "155px"
                  }
                },
                "type": "ia.input.dropdown"
              }
            ],
            "meta": {
              "name": "AggMode"
            },
            "props": {
              "style": {
                "gap": "10px"
              },
              "wrap": "wrap"
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "TitleAndAgg"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "justify": "space-between",
          "style": {
            "row-gap": "15px"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "TimeSeriesChart"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.plots[0].trends[0].columns": {
            "binding": {
              "config": {
                "path": "view.custom.tags"
              },
              "transforms": [
                {
                  "code": "\tcolumns \u003d []\n\t\n\tcolors \u003d [\"var(--kpi-primary)\", \"var(--kpi-highlight)\"]\n\tindex \u003d 0\n\t\n\tfor tag in value:\n\t\ttry:\n\t\t\tcolor \u003d colors[index]\n\t\texcept:\n\t\t\t# Widget is designed to handle two tags. But if more than 1 tag is added\n\t\t\t# then let the chart pick a color.\n\t\t\tcolor \u003d None\n\t\t\n\t\tcolumn \u003d {\"key\": tag.get(\u0027alias\u0027), \"color\": color, \"styles\": {\"normal\": {\"stroke\": {\"color\": \"\", \"width\": 2, \"opacity\": None, \"dashArray\": None},\n\t\t\t\"fill\": {\"color\": \"\", \"opacity\": None}}, \"highlighted\": {\"stroke\": {\"color\": \"\", \"width\": 2, \"opacity\": None, \"dashArray\": None},\n\t\t\t\"fill\": {\"color\": \"\", \"opacity\": None}}, \"selected\": {\"stroke\": {\"color\": \"\", \"width\": 2, \"opacity\": None, \"dashArray\": None},\n\t\t\t\"fill\": {\"color\": \"\",\"opacity\": None}}, \"muted\": {\"stroke\": {\"color\": \"\", \"width\": 2, \"opacity\": None, \"dashArray\": None},\n\t\t\t\"fill\": {\"color\": \"\", \"opacity\": None}}}}\n\t\t\t\n\t\tcolumns.append(column)\n\t\t\n\t\tindex \u003d index + 1\n\t\t\n\treturn columns",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.series[0].data": {
            "binding": {
              "config": {
                "path": "view.custom.history"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "legend": {
            "visible": true
          },
          "plots": [
            {
              "axes": [],
              "markers": [],
              "relativeWeight": 1,
              "trends": [
                {
                  "axis": "",
                  "baselines": [],
                  "breakLine": true,
                  "interpolation": "curveLinear",
                  "radius": 2,
                  "series": "Data",
                  "stack": true,
                  "type": "line",
                  "visible": true
                }
              ]
            }
          ],
          "series": [
            {
              "name": "Data"
            }
          ]
        },
        "type": "ia.chart.timeseries"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tviewPath \u003d \u0027Exchange/Launchpad/Kpi/EmbeddedViews/PopupDualTag\u0027\n\ttags \u003d self.view.custom.tags\n\tif len(tags) \u003d\u003d 0:\n\t\tpath1 \u003d \u0027\u0027\n\t\tpath2 \u003d \u0027\u0027\n\telif len(tags) \u003d\u003d 1:\n\t\tpath1 \u003d tags[0][\u0027path\u0027]\n\t\tpath2 \u003d \u0027\u0027\n\telif len(tags) \u003d\u003d 2:\n\t\tpath1 \u003d tags[0][\u0027path\u0027]\n\t\tpath2 \u003d tags[1][\u0027path\u0027]\n\t\n\tviewParams \u003d {\u0027path1\u0027: path1, \u0027path2\u0027: path2, \u0027historyProvider\u0027: self.session.custom.exchange.historyProvider}\n\tpopupTitle \u003d self.view.params.title\n\texchange.launchpad.util.popup(self, viewPath, viewParams, popupTitle)"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "exchange/launchpad/kpi/card",
        "cursor": "pointer",
        "gap": "5px"
      }
    },
    "type": "ia.container.flex"
  }
}